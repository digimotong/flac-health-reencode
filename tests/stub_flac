#!/usr/bin/env bash
# Test stub for the 'flac' binary - the real one is NOT required to run the suite.
# It fakes the two behaviors the script relies on:
#
#   flac -t <file>          exit 0 normally; exit 1 when <file> contains CORRUPT
#                           (simulates a corrupt file, so scans flag it).
#   flac --verify ... -o <out> <in>
#                           write the marker to <out> and exit 0; the script's
#                           cp/mv then moves it over the original.
#
# If the real script changes the flac flags it passes, update this stub to match.
#
# Env knobs (all optional):
#   STUB_FLAC_SLEEP       seconds to sleep on the re-encode path
#   STUB_FLAC_TEST_SLEEP  seconds to sleep on the verify path ('flac -t')
#   STUB_FLAC_SLOT_DIR    directory that turns the stub into a concurrency probe
#
# The sleeps exist so case_parallel.sh can hold N operations open at once and
# observe real overlap: an instant stub finishes before the parent can fork the
# next worker, so even a serial implementation can look parallel. They are kept
# separate so a case can slow one operation without touching the other.
#
# STUB_FLAC_SLOT_DIR makes the overlap assertion exact: each invocation claims the
# lowest-numbered free slot via `mkdir` (atomic), so a process winning slot N has
# proven that N-1 siblings were in flight at that instant, and the highest rank
# claimed IS the peak concurrency (no clocks or floats involved). One record file
# per process avoids interleaved shared appends. The probe covers both modes, so a
# parallel scan is measurable too; it is released from an EXIT trap, which fires
# on every exit path (including the failure return for an unreadable input, where a
# trailing rmdir would be skipped). Ungated, it would cost a leaked slot that
# inflates the next run's ranking, hence the env-var gate.

out=''
infile=''
prev=''
for arg in "$@"; do
    if [ "$prev" = '-o' ]; then
        out="$arg"
    fi
    prev="$arg"
done

# Last positional argument is the input file for both -t and re-encode modes. Use
# the array's final element directly rather than an array-to-string slice: ${@: -1}
# would be an array assignment (SC2124) and silently joins trailing words.
infile="${*: -1}"

# Concurrency probe (see STUB_FLAC_SLOT_DIR above). Claimed BEFORE the mode branches
# so a scan's verifies are measurable, and held for this whole invocation.
slot=''
if [ -n "${STUB_FLAC_SLOT_DIR:-}" ]; then
    mkdir -p "$STUB_FLAC_SLOT_DIR"
    n=0
    while :; do
        n=$((n + 1))
        mkdir "$STUB_FLAC_SLOT_DIR/$n" 2>/dev/null && break
        # 64 is far above any worker count a test uses; the guard exists only so a
        # leaked slot cannot spin here forever.
        if [ "$n" -ge 64 ]; then
            n=0
            break
        fi
    done
    slot="$STUB_FLAC_SLOT_DIR/$n"
    printf '%s\n' "$n" > "$STUB_FLAC_SLOT_DIR/$$.rank"
    trap 'rmdir "$slot" 2>/dev/null || true' EXIT
fi

if [[ " $* " == *' -t '* ]]; then
    # Test mode (what a scan drives).
    if [ -n "${STUB_FLAC_TEST_SLEEP:-}" ]; then
        sleep "$STUB_FLAC_TEST_SLEEP"
    fi
    if [ -f "$infile" ] && grep -q CORRUPT "$infile" 2>/dev/null; then
        exit 1
    fi
    exit 0
fi

# Hold this reencode open when asked, so a concurrent run has a window in which
# several workers are genuinely in flight (see STUB_FLAC_SLEEP above).
if [ -n "${STUB_FLAC_SLEEP:-}" ]; then
    sleep "$STUB_FLAC_SLEEP"
fi

# Re-encode mode: overwrite the temp target with a single file-INDEPENDENT marker
# line, so tests can assert "original replaced by the marker" and "no backup ever
# carries the marker" without depending on the file name.
if [ -n "$out" ]; then
    printf 'REENCODE_OK\n' > "$out"
fi
exit 0
