#!/usr/bin/env bash
# Test stub for the 'metaflac' binary - the real one is NOT required to run the
# suite. The script only reads the audio MD5 via:
#   metaflac --show-md5sum <file>
# This stub emits a stable 32-hex md5 derived from the file's content, so the
# tracking database gets deterministic, content-keyed values that support the
# skip-if-already-reencoded tests.

case " $* " in
    *' --show-md5sum '*)
        # Emit md5 for the file that follows --show-md5sum.
        file=''
        prev=''
        for arg in "$@"; do
            if [ "$prev" = '--show-md5sum' ]; then
                file="$arg"
                break
            fi
            prev="$arg"
        done
        if [ -n "$file" ]; then
            md5sum < "$file" | awk '{print $1}'
            exit 0
        fi
        ;;
    *' --show-total-samples '*)
        # The script reads this ONLY on the damaged-input retry path (see
        # reencode_one_file): flac >= 1.5 refuses a FLAC->FLAC re-encode whose
        # decoded audio no longer matches the input's STREAMINFO MD5, and a non-zero
        # --until disables that comparison. Any positive, stable number works here,
        # since the stub never actually trims. Derived from the file size so it is
        # deterministic and non-zero for every real (non-empty) fixture.
        file=''
        prev=''
        for arg in "$@"; do
            if [ "$prev" = '--show-total-samples' ]; then
                file="$arg"
                break
            fi
            prev="$arg"
        done
        if [ -n "$file" ] && [ -f "$file" ]; then
            size=$(wc -c < "$file")
            printf '%s\n' "$(( size * 100 ))"
            exit 0
        fi
        ;;
esac

# Anything else: report success with no output (callers tolerate that).
exit 0
