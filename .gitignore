*
*/

!.gitignore
!README.md
!LICENSE
!flac_health_reencode.sh

# Test suite + CI config (see tests/README-free run_tests.sh; README notes)
!.shellcheckrc
!tests/
!tests/*
!.github/
!.github/*
!.github/workflows/
!.github/workflows/*
# tests/manual/ holds the real-flac harness. `!tests/*` does NOT descend into a
# subdirectory, so the dir needs its own allowlist entries or it is silently
# ignored by git - the same failure mode the workflow's tracked-files step exists
# to catch. See tests/manual/README.md.
!tests/manual/
!tests/manual/*
